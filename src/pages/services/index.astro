---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Loft Conversion Services Cambridge | Kitchen, Bathroom &amp; Extensions"
  description="Complete loft conversion services in Cambridge. Kitchen refurbishments, bathroom renovations, house extensions &amp; attic conversions. Professional builders, free quotes."
  ogImage="/wp-content/uploads/Loft-Conversion/best-company-loft-conversion.webp"
>
  <link slot="head" rel="stylesheet" href="/wp-content/themes/truleum-theme/assets/css/services.css">

  <main class="main-content services-page">

    <!-- What We Offer Section -->
    <div class="what-we-offer-services">
      <div class="what-we-offer-container">
        <!-- Content Column -->
        <div class="offer-content-column">
          <h2 class="offer-title">
            WHAT WE OFFER
          </h2>

          <p class="offer-description">
            At Truleum, we specialise in high-quality loft conversions in Cambridge and London, house extensions, and full home renovations. With a focus on reliability, attention to detail, and seamless project management, we ensure every project from kitchen refurbishment Cambridge to bathroom renovation London is completed to the highest standard.
From the initial concept to final handover, we work closely with you to bring your vision to life, making the process smooth, stress-free, and tailored to your needs.
          </p>

          <p class="offer-description">
            <a href="/contact/">Contact us</a> today for a free, no-obligation quote and we'd love to discuss your <a href="/loft-conversion-cambridge-guide/">loft conversion Cambridge</a>, house extension Cambridge, or any home renovation project.
          </p>

          <p class="offer-description">
            Helpful resources: <a href="/services/loft-conversion-cambridge-service/">Loft Conversion Cambridge Service</a> | <a href="/loft-conversion-cambridge/">Cambridge Area Page</a> | <a href="/loft-conversion-glossary/">Loft Conversion Glossary</a>.
          </p>

          <div class="offer-cta">
            <a href="/contact/" class="offer-btn">
              ENQUIRE NOW
            </a>
          </div>
        </div>

        <!-- Image Column -->
        <div class="offer-image-column">
          <img src="/wp-content/uploads/2025/09/construction-services.webp" alt="Truleum Home Extension and Loft Conversion" class="offer-image">
        </div>
      </div>
    </div>

    <!-- Services Categories Section -->
    <div class="services-categories-services">
      <div class="services-categories-container">
        <div class="services-grid">

          <!-- Loft Conversions -->
          <a href="/services/loft-conversion-cambridge-service/" class="service-card">
            <div class="service-image">
              <img src="/wp-content/uploads/Loft-Conversion/loft-conversion-cambridge.webp" alt="Professional Loft Conversions in Cambridge and London">
            </div>
            <div class="service-content">
              <h3 class="service-title">LOFT CONVERSION CAMBRIDGE</h3>
            </div>
          </a>

          <!-- Kitchen Fitting -->
          <a href="/gallery/?category=kitchen-refurbishment" class="service-card">
            <div class="service-image">
              <img src="/wp-content/uploads/Kitchen-Refurbishment/renovation-kitchen-service-cambridgeshire.webp" alt="Expert Kitchen Fitting and Renovation Services">
            </div>
            <div class="service-content">
              <h3 class="service-title">KITCHEN REFURBISHMENT</h3>
            </div>
          </a>

          <!-- Bathroom Renovation -->
          <a href="/gallery/?category=bathroom-renovation" class="service-card">
            <div class="service-image">
              <img src="/wp-content/uploads/Bathroom-Renovation/london-renovation-bathroom.webp" alt="Complete Bathroom Renovation and Refurbishment">
            </div>
            <div class="service-content">
              <h3 class="service-title">BATHROOM RENOVATION</h3>
            </div>
          </a>

          <!-- House Extension -->
          <a href="/gallery/?category=house-extension" class="service-card">
            <div class="service-image">
              <img src="/wp-content/uploads/House-Extension/construction-company-cambridge.webp" alt="Full House Extension and Home Extension Services">
            </div>
            <div class="service-content">
              <h3 class="service-title">HOUSE EXTENSION</h3>
            </div>
          </a>

        </div>
      </div>
    </div>

    <!-- Expertly Designed Section -->
    <div class="expertly-designed-services">
      <div class="expertly-designed-container">
        <!-- Image Column -->
        <div class="design-image-column">
          <img src="/wp-content/uploads/2025/09/service-renovation-cambridge-company.webp" alt="Professional Architectural Plans for Loft Conversions and Home Extensions in Cambridge" class="design-image">
        </div>

        <!-- Content Column -->
        <div class="design-content-column">
          <h2 class="design-title">
            Expertly Designed,<br>
            Professionally Built
          </h2>

          <p class="design-description">
            At Truleum, we manage the entire construction process in-house, making your experience smooth and hassle-free. Our qualified architects design detailed plans for loft conversions in Cambridge and London, as well as house extensions in Cambridge, ensuring <a href="/gallery/">every project</a> is functional, stylish, and perfectly suited to your home. By combining design and construction services under one roof, we deliver a seamless and efficient process with minimal delays.
We're dedicated to turning your vision into reality through careful planning, skilled craftsmanship, and a stress-free approach from the initial consultation to project completion. Whether it's a loft conversion Cambridge, house extension Cambridge, kitchen refurbishment Cambridge, or bathroom renovation London, our team ensures every detail is handled to the highest standard.
          </p>

          <p class="design-description">
            We're committed to transforming your vision into reality through meticulous planning, expert craftsmanship, and a stress-free approach from initial consultation to project completion.
          </p>

          <div class="design-cta">
            <a href="/gallery/" class="design-btn">
              VIEW OUR WORK
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Loft Conversion Process Section -->
    <div class="loft-conversion-process-services">
      <div class="process-container">
        <h2 class="process-main-title">
          Our Loft Conversion Process:<br>
          From Design to Completion
        </h2>

        <div class="process-flowchart">
          <!-- Row 1: Steps 1-3 -->
          <div class="flowchart-row">
            <div class="process-step">
              <div class="step-number">1</div>
              <div class="step-icon">
                <i class="fas fa-phone-alt"></i>
              </div>
              <h3 class="step-title">Get In Touch</h3>
            </div>
            <div class="arrow-right">
              <i class="fas fa-arrow-right"></i>
            </div>
            <div class="process-step">
              <div class="step-number">2</div>
              <div class="step-icon">
                <i class="fas fa-handshake"></i>
              </div>
              <h3 class="step-title">A Friendly Meeting</h3>
            </div>
            <div class="arrow-right">
              <i class="fas fa-arrow-right"></i>
            </div>
            <div class="process-step">
              <div class="step-number">3</div>
              <div class="step-icon">
                <i class="fas fa-drafting-compass"></i>
              </div>
              <h3 class="step-title">Draw Up Plans</h3>
            </div>
          </div>

          <!-- Arrow Down (Right Side: 3 to 4) -->
          <div class="arrow-down-container arrow-down-right">
            <div class="arrow-down">
              <i class="fas fa-arrow-down"></i>
            </div>
          </div>

          <!-- Row 2: Steps 4-6 (Reverse Order) -->
          <div class="flowchart-row reverse">
            <div class="process-step">
              <div class="step-number">4</div>
              <div class="step-icon">
                <i class="fas fa-hammer"></i>
              </div>
              <h3 class="step-title">Do the Work</h3>
            </div>
            <div class="arrow-left">
              <i class="fas fa-arrow-left"></i>
            </div>
            <div class="process-step">
              <div class="step-number">5</div>
              <div class="step-icon">
                <i class="fas fa-building"></i>
              </div>
              <h3 class="step-title">Scaffolding</h3>
            </div>
            <div class="arrow-left">
              <i class="fas fa-arrow-left"></i>
            </div>
            <div class="process-step">
              <div class="step-number">6</div>
              <div class="step-icon">
                <i class="fas fa-cubes"></i>
              </div>
              <h3 class="step-title">Materials</h3>
            </div>
          </div>

          <!-- Arrow Down (Left Side: 6 to 7) -->
          <div class="arrow-down-container arrow-down-left">
            <div class="arrow-down">
              <i class="fas fa-arrow-down"></i>
            </div>
          </div>

          <!-- Row 3: Steps 7-9 -->
          <div class="flowchart-row">
            <div class="process-step">
              <div class="step-number">7</div>
              <div class="step-icon">
                <i class="fas fa-tools"></i>
              </div>
              <h3 class="step-title">Ripped Out</h3>
            </div>
            <div class="arrow-right">
              <i class="fas fa-arrow-right"></i>
            </div>
            <div class="process-step">
              <div class="step-number">8</div>
              <div class="step-icon">
                <i class="fas fa-home"></i>
              </div>
              <h3 class="step-title">Beams &amp; Cladding</h3>
            </div>
            <div class="arrow-right">
              <i class="fas fa-arrow-right"></i>
            </div>
            <div class="process-step">
              <div class="step-number">9</div>
              <div class="step-icon">
                <i class="fas fa-window-maximize"></i>
              </div>
              <h3 class="step-title">Windows</h3>
            </div>
          </div>

          <!-- Arrow Down (Right Side: 9 to 10) -->
          <div class="arrow-down-container arrow-down-right">
            <div class="arrow-down">
              <i class="fas fa-arrow-down"></i>
            </div>
          </div>

          <!-- Row 4: Steps 10-12 (Reverse Order) -->
          <div class="flowchart-row reverse">
            <div class="process-step">
              <div class="step-number">10</div>
              <div class="step-icon">
                <i class="fas fa-paint-roller"></i>
              </div>
              <h3 class="step-title">Plastering</h3>
            </div>
            <div class="arrow-left">
              <i class="fas fa-arrow-left"></i>
            </div>
            <div class="process-step">
              <div class="step-number">11</div>
              <div class="step-icon">
                <i class="fas fa-wrench"></i>
              </div>
              <h3 class="step-title">Plumbing &amp; Finishing</h3>
            </div>
            <div class="arrow-left">
              <i class="fas fa-arrow-left"></i>
            </div>
            <div class="process-step">
              <div class="step-number">12</div>
              <div class="step-icon">
                <i class="fas fa-clipboard-check"></i>
              </div>
              <h3 class="step-title">Inspection &amp; Sign Off</h3>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="dont-delay-section section">
      <div class="contact-cta">
        <div>
          <h2>DON'T DELAY CONTACT US TODAY</h2>
          <p>Contact us today for more information and a free no-obligation quote tailored to your requirements and ideas.</p>
          <a href="/contact/" class="dont-delay">ENQUIRE NOW</a>
        </div>
      </div>
    </section>

  </main>

</BaseLayout>
