          <div class="category-images" data-category="glass-transitions">
            <img src="/wp-content/uploads/Glass-Transitions/glass-transitions-cambridge-loft-conversion-glass-roof.webp" alt="Glass Transitions Cambridge Loft Conversion Glass Roof">
          </div>

        </div>
      </div>
    </div>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="lightbox">
      <div class="lightbox-content">
        <span class="lightbox-close">×</span>
        <img class="lightbox-image" src="" alt="">
        <div class="lightbox-info">
          <h3 class="lightbox-title"></h3>
          <p class="lightbox-description"></p>
        </div>
        <div class="lightbox-nav">
          <button class="lightbox-prev">‹</button>
          <button class="lightbox-next">›</button>
        </div>
      </div>
    </div>

    <section class="dont-delay-section section">
      <div class="contact-cta">
        <div>
          <h2>DON'T DELAY CONTACT US TODAY</h2>
          <p>Contact us today for more information and a free no-obligation quote tailored to your requirements and ideas.</p>
          <a href="/contact/" class="dont-delay">ENQUIRE NOW</a>
        </div>
      </div>
    </section>

  </main>

  <script is:inline src="/wp-content/themes/truleum-theme/assets/js/gallery-filters.js"></script>

</BaseLayout>
