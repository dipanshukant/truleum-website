          </div>

          <!-- Driveways Images (6) -->
          <div class="category-images" data-category="driveways">
            <img src="/wp-content/uploads/Driveways/driveways-loft-conversion-cambridge-block-paving.webp" alt="Driveways Loft Conversion Cambridge Block Paving">
            <img src="/wp-content/uploads/Driveways/driveways-cambridge-loft-conversion-resin-bound.webp" alt="Driveways Cambridge Loft Conversion Resin Bound">
            <img src="/wp-content/uploads/Driveways/driveways-loft-conversion-cambridge-gravel-drive.webp" alt="Driveways Loft Conversion Cambridge Gravel Drive">
