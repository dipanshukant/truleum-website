---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Thank You - Truleum Loft Specialist"
  description="Thank you for your quote request. We've received your details and will be in touch within 24 hours with your personalised quote."
>
  <link slot="head" rel="stylesheet" href="/wp-content/themes/truleum-theme/assets/css/thank-you.css">

  <main class="main-content">
    <main class="thank-you-page">
      <!-- Thank You Hero Section -->
      <section class="thank-you-hero">
        <div class="thank-you-hero-container">
          <div class="thank-you-hero-content">
            <div class="success-animation">
              <div class="checkmark-circle">
                <div class="checkmark"></div>
              </div>
            </div>
            <h1 class="thank-you-title">Thank You!</h1>
            <p class="thank-you-subtitle">
              Your quote request has been successfully submitted. We've received all your details and will be in touch within 24 hours with your personalized quote.
            </p>
            <div class="thank-you-details">
              <div class="detail-item">
                <span class="detail-icon">📧</span>
                <span class="detail-text">Confirmation sent to your email</span>
              </div>
              <div class="detail-item">
                <span class="detail-icon">⏰</span>
                <span class="detail-text">Response within 24 hours</span>
              </div>
              <div class="detail-item">
                <span class="detail-icon">💬</span>
                <span class="detail-text">Free consultation included</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Thank You Content Section -->
      <section class="thank-you-content">
        <div class="thank-you-content-container">
          <div class="content-grid">
            <!-- What Happens Next -->
            <div class="content-card">
              <div class="card-icon">
                <span>📋</span>
              </div>
              <h3>What Happens Next?</h3>
              <ul class="process-list">
                <li>We'll review your project requirements</li>
                <li>Our team will prepare a detailed quote</li>
                <li>You'll receive a personalized proposal</li>
                <li>We'll schedule a free consultation</li>
              </ul>
            </div>

            <!-- Why Choose Truleum -->
            <div class="content-card">
              <div class="card-icon">
                <span>⭐</span>
              </div>
              <h3>Why Choose Truleum?</h3>
              <ul class="benefits-list">
                <li>Expert loft conversion specialists</li>
                <li>Full project management service</li>
                <li>Qualified architects in-house</li>
                <li>Stress-free experience guaranteed</li>
              </ul>
            </div>

            <!-- Contact Information -->
            <div class="content-card">
              <div class="card-icon">
                <span>📞</span>
              </div>
              <h3>Need to Reach Us?</h3>
              <div class="contact-details">
                <p><strong>Phone:</strong> <a href="tel:+447857035925">07857 035925</a></p>
                <p><strong>Email:</strong> <a href="mailto:Truleumloftspecialist@gmail.com">Truleumloftspecialist@gmail.com</a></p>
                <p><strong>Address:</strong> Truleum Loft Specialist Ltd, 3rd Floor, 86-90 Paul Street, London, England, United Kingdom, EC2A 4NE</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Thank You Next Steps Section -->
      <section class="thank-you-next-steps">
        <div class="next-steps-container">
          <h2>While You Wait...</h2>
          <p class="next-steps-intro">Explore more about our services and see examples of our work:</p>

          <div class="action-buttons">
            <a href="/gallery/" class="action-btn primary">
              <span class="btn-icon">🏠</span>
              <span class="btn-content">
                <strong>View Our Work</strong>
                <small>See completed projects</small>
              </span>
            </a>

            <a href="/services/" class="action-btn secondary">
              <span class="btn-icon">🔧</span>
              <span class="btn-content">
                <strong>Our Services</strong>
                <small>Learn about our services</small>
              </span>
            </a>

            <a href="/about-us/" class="action-btn secondary">
              <span class="btn-icon">👥</span>
              <span class="btn-content">
                <strong>About Truleum</strong>
                <small>Know more about us</small>
              </span>
            </a>
          </div>

          <div class="return-home">
            <a href="/" class="home-link">
              ← Return to Homepage
            </a>
          </div>
        </div>
      </section>
    </main>
  </main>
</BaseLayout>
