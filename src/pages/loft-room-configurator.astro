---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Loft Conversion Room Configurator Cambridge | Truleum"
  description="Visualise your Cambridge loft conversion layout. Pick your loft type and room configuration to see an instant floor plan — free, no registration needed."
  canonical="https://truleumloftspecialist.com/loft-room-configurator/"
>

<nav class="rc-breadcrumb" aria-label="Breadcrumb">
  <div class="rc-breadcrumb-inner">
    <a href="/">Home</a><span>›</span><span>Loft Room Configurator</span>
  </div>
</nav>

<style>
*{box-sizing:border-box;}
.rc-breadcrumb{background:#0d1f5c;border-bottom:1px solid rgba(255,255,255,0.08);padding:10px 20px;font-family:'Poppins',Arial,sans-serif;}
.rc-breadcrumb-inner{max-width:1000px;margin:0 auto;font-size:13px;color:rgba(255,255,255,0.5);display:flex;gap:8px;align-items:center;}
.rc-breadcrumb a{color:rgba(255,255,255,0.8);text-decoration:none;font-weight:600;}
.rc-breadcrumb a:hover{color:#c9902e;}

/* Hero */
.rc-hero{background:linear-gradient(135deg,#060f32 0%,#0f2460 100%);padding:56px 20px 48px;text-align:center;font-family:'Poppins',Arial,sans-serif;}
.rc-hero h1{font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:900;color:#fff;line-height:1.2;margin-bottom:12px;}
.rc-hero h1 em{font-style:normal;color:#c9902e;}
.rc-hero p{color:rgba(255,255,255,0.65);font-size:1rem;max-width:500px;margin:0 auto 36px;}

/* Loft type selector */
.loft-type-cards{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;max-width:900px;margin:0 auto;}
.lt-card{background:rgba(255,255,255,0.07);border:1.5px solid rgba(255,255,255,0.12);border-radius:14px;padding:16px 20px;cursor:pointer;transition:all 0.2s ease;text-align:center;min-width:140px;flex:1;font-family:'Poppins',Arial,sans-serif;color:rgba(255,255,255,0.75);user-select:none;}
.lt-card:hover{background:rgba(255,255,255,0.12);border-color:rgba(201,144,46,0.4);color:#fff;transform:translateY(-2px);}
.lt-card.active{background:#d97706;border-color:#d97706;color:#fff;transform:translateY(-2px);box-shadow:none;}
.lt-card-icon{font-size:22px;margin-bottom:8px;display:block;}
.lt-card-name{font-size:12px;font-weight:700;line-height:1.3;}

/* Main configurator area */
.rc-wrap{background:#e8ecf5;font-family:'Poppins',Arial,sans-serif;padding:56px 20px 120px;}
.rc-inner{max-width:1000px;margin:0 auto;}
.rc-step-label{font-size:11px;font-weight:800;color:#9ca3af;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:12px;}

/* Room config selector */
.room-config-cards{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:36px;}
.rc-card{background:#fff;border:1.5px solid #d1d5db;border-radius:12px;padding:12px 18px;cursor:pointer;transition:all 0.18s ease;font-size:13px;font-weight:600;color:#374151;font-family:'Poppins',Arial,sans-serif;}
.rc-card:hover{border-color:#0a1a4a;color:#0a1a4a;transform:translateY(-1px);}
.rc-card.active{background:#0a1a4a;border-color:#0a1a4a;color:#fff;}

/* Floor plan display */
.floorplan-display{display:grid;grid-template-columns:1fr 280px;gap:24px;align-items:start;}
.floorplan-svg-wrap{background:#fff;border-radius:20px;border:1px solid #d1d5db;box-shadow:0 8px 40px rgba(10,26,74,0.1);padding:28px;overflow:hidden;}
.floorplan-svg-wrap svg{width:100%;height:auto;display:block;}
.floorplan-svg-wrap .fp-label{display:block;text-align:center;font-size:11px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:1.5px;margin-top:16px;}

/* Info panel */
.fp-info{background:#fff;border-radius:20px;border:1px solid #d1d5db;box-shadow:0 8px 40px rgba(10,26,74,0.1);padding:28px;}
.fp-info-title{font-size:1.1rem;font-weight:800;color:#0a1a4a;margin-bottom:6px;}
.fp-info-type{font-size:11px;font-weight:700;color:#c9902e;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px;}
.fp-stats{display:flex;flex-direction:column;gap:10px;margin-bottom:20px;}
.fp-stat{display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:#f3f4f6;border-radius:8px;font-size:13px;}
.fp-stat-key{color:#6b7280;font-weight:600;}
.fp-stat-val{color:#0a1a4a;font-weight:800;}
.fp-rooms-title{font-size:11px;font-weight:800;color:#9ca3af;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;}
.fp-room-list{list-style:none;padding:0;margin:0 0 20px;display:flex;flex-direction:column;gap:7px;}
.fp-room-list li{display:flex;align-items:center;gap:8px;font-size:13px;color:#374151;font-weight:600;}
.fp-room-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0;}
.fp-desc{font-size:13px;color:#6b7280;line-height:1.6;margin-bottom:20px;}
.fp-cta{display:block;background:linear-gradient(135deg, #ffe89f 0%, #75561d 100%);color:#0a1a4a;font-weight:800;font-size:13px;border-radius:50px;padding:13px 20px;text-decoration:none;transition:all 0.2s ease;text-align:center;letter-spacing:0.3px;}
.fp-cta:hover{background:#d97706;transform:translateY(-2px);}

/* Legend */
.fp-legend{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px;}
.fp-legend-item{display:flex;align-items:center;gap:5px;font-size:11px;color:#6b7280;font-weight:600;}
.fp-legend-dot{width:10px;height:10px;border-radius:2px;}

@media(max-width:720px){
  .floorplan-display{grid-template-columns:1fr;}
  .loft-type-cards{gap:8px;}
  .lt-card{min-width:calc(50% - 8px);flex:unset;}
}
</style>

<!-- Hero -->
<section class="rc-hero">
  <h1>Loft <em>Room Configurator</em></h1>
  <p>Pick your loft type and room layout to instantly see a floor plan — before you speak to anyone.</p>
  <div class="loft-type-cards">
    <div class="lt-card active" data-loft="velux"><span class="lt-card-icon">🏠</span><div class="lt-card-name">Velux / Roof Light</div></div>
    <div class="lt-card" data-loft="dormer"><span class="lt-card-icon">🏗️</span><div class="lt-card-name">Dormer</div></div>
    <div class="lt-card" data-loft="hipgable"><span class="lt-card-icon">🏡</span><div class="lt-card-name">Hip-to-Gable</div></div>
    <div class="lt-card" data-loft="mansard"><span class="lt-card-icon">🏢</span><div class="lt-card-name">Mansard</div></div>
    <div class="lt-card" data-loft="lshaped"><span class="lt-card-icon">📐</span><div class="lt-card-name">L-Shaped Dormer</div></div>
  </div>
</section>

<div class="rc-wrap">
  <div class="rc-inner">
    <div class="rc-step-label">Step 2 — Choose your room layout</div>
    <div class="room-config-cards" id="roomConfigCards"></div>
    <div class="floorplan-display">
      <div class="floorplan-svg-wrap">
        <div id="svgContainer"></div>
        <span class="fp-label">Not to scale — indicative layout only</span>
        <div class="fp-legend">
          <div class="fp-legend-item"><div class="fp-legend-dot" style="background:#bfdbfe;"></div>Bedroom</div>
          <div class="fp-legend-item"><div class="fp-legend-dot" style="background:#bbf7d0;"></div>Bathroom</div>
          <div class="fp-legend-item"><div class="fp-legend-dot" style="background:#fde68a;"></div>Office/Study</div>
          <div class="fp-legend-item"><div class="fp-legend-dot" style="background:#e9d5ff;"></div>Wardrobe/Storage</div>
          <div class="fp-legend-item"><div class="fp-legend-dot" style="background:#f1f5f9;"></div>Landing/Stairs</div>
        </div>
      </div>
      <div class="fp-info" id="fpInfo"></div>
    </div>
  </div>
</div>

<script is:inline>
(function(){

/* ── DATA ── */
var configs = {
