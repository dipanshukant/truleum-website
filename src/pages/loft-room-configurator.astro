          <rect x="20" y="140" width="240" height="160" fill="#bfdbfe" stroke="#0a1a4a" stroke-width="3"/>
          <text x="140" y="224" text-anchor="middle" font-size="14" font-weight="700" fill="#1e40af">BEDROOM</text>
          <!-- Landing -->
          <rect x="260" y="140" width="160" height="160" fill="#f1f5f9" stroke="#0a1a4a" stroke-width="3"/>
          <text x="340" y="224" text-anchor="middle" font-size="11" font-weight="700" fill="#64748b">LANDING ▼</text>
          <!-- Windows -->
          <rect x="35" y="28" width="70" height="28" fill="none" stroke="#60a5fa" stroke-width="2" rx="2"/>
          <text x="70" y="46" text-anchor="middle" font-size="9" fill="#60a5fa">DORMER</text>
        </svg>`
      }
    ]
  }
};

/* ── State ── */
var currentLoft = 'velux';
var currentConfig = 0;

function renderRoomCards() {
  var opts = configs[currentLoft].options;
  var container = document.getElementById('roomConfigCards');
  container.innerHTML = '';
  opts.forEach(function(opt, i) {
    var btn = document.createElement('button');
    btn.className = 'rc-card' + (i === currentConfig ? ' active' : '');
    btn.textContent = opt.label;
    btn.addEventListener('click', function() {
      currentConfig = i;
      renderRoomCards();
      renderPlan();
    });
    container.appendChild(btn);
  });
}

function renderPlan() {
  var opt = configs[currentLoft].options[currentConfig];
  document.getElementById('svgContainer').innerHTML = opt.svg;
  var info = document.getElementById('fpInfo');
  var roomsHTML = opt.rooms.map(function(r, i) {
    return '<li><div class="fp-room-dot" style="background:' + (opt.colors[i] || '#e5e7eb') + ';"></div>' + r + '</li>';
  }).join('');
  info.innerHTML = '<div class="fp-info-type">' + configs[currentLoft].label + '</div>' +
    '<div class="fp-info-title">' + opt.label + '</div>' +
    '<div class="fp-stats">' +
      '<div class="fp-stat"><span class="fp-stat-key">Floor area</span><span class="fp-stat-val">' + opt.sqm + '</span></div>' +
      '<div class="fp-stat"><span class="fp-stat-key">Ceiling height</span><span class="fp-stat-val">' + opt.height + '</span></div>' +
      '<div class="fp-stat"><span class="fp-stat-key">Planning</span><span class="fp-stat-val">' + opt.planning + '</span></div>' +
    '</div>' +
    '<div class="fp-rooms-title">Rooms in this layout</div>' +
    '<ul class="fp-room-list">' + roomsHTML + '</ul>' +
    '<p class="fp-desc">' + opt.desc + '</p>' +
    '<a href="/contact/" class="fp-cta">Get a Free Quote for This Layout</a>';
}

/* ── Init ── */
renderRoomCards();
renderPlan();

/* ── Loft type switching ── */
document.querySelectorAll('.lt-card').forEach(function(card) {
  card.addEventListener('click', function() {
    document.querySelectorAll('.lt-card').forEach(function(c) { c.classList.remove('active'); });
    card.classList.add('active');
    currentLoft = card.dataset.loft;
    currentConfig = 0;
    renderRoomCards();
    renderPlan();
  });
});

})();
</script>

