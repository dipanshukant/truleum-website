function goStep(n) {
  if (n === 2 && !houseType) return;
  if (n === 3 && !loftType) return;
  document.querySelectorAll('.wiz-step').forEach(function(s){ s.classList.remove('active'); });
  if (n <= 3) document.getElementById('step' + n).classList.add('active');
  document.getElementById('step-result').style.display = 'none';
  document.getElementById('step-result').classList.remove('active');
  for (var i = 1; i <= 3; i++) {
    var dot = document.getElementById('dot' + i);
    var lbl = document.getElementById('lbl' + i);
    dot.className = i < n ? 'rc-step-dot done' : (i === n ? 'rc-step-dot active' : 'rc-step-dot pending');
    lbl.className = i === n ? 'rc-step-label-txt active' : 'rc-step-label-txt';
    if (i < 3) document.getElementById('line' + i).className = i < n ? 'rc-step-line done' : 'rc-step-line';
  }
  if (n === 2 && houseType) {
    var rec = recMap[houseType];
    document.getElementById('recBannerText').innerHTML = rec.reason;
    document.getElementById('recBanner').classList.add('visible');
    ['velux','dormer','hipgable','lshaped','mansard'].forEach(function(lt){
      var b = document.getElementById('badge-' + lt);
      if (b) b.style.display = lt === rec.loft ? 'block' : 'none';
      var c = document.querySelector('.loft-card[data-val="' + lt + '"]');
      if (c) c.classList.toggle('recommended', lt === rec.loft);
    });
  }
}

function pickHouse(card) {
  document.querySelectorAll('#step1 .choice-card').forEach(function(c){ c.classList.remove('selected'); });
  card.classList.add('selected');
  houseType = card.dataset.val;
  document.getElementById('next1').classList.add('ready');
}

function pickLoft(card) {
  document.querySelectorAll('.loft-card').forEach(function(c){ c.classList.remove('selected'); });
  card.classList.add('selected');
  loftType = card.dataset.val;
  document.getElementById('next2').classList.add('ready');
}

function pickRoom(card) {
  document.querySelectorAll('.room-card').forEach(function(c){ c.classList.remove('selected'); });
  card.classList.add('selected');
  roomUse = card.dataset.val;
  document.getElementById('next3').classList.add('ready');
}

function showResult() {
  if (!houseType || !loftType || !roomUse) return;
  document.querySelectorAll('.wiz-step').forEach(function(s){ s.classList.remove('active'); });
  for (var i = 1; i <= 3; i++) {
    document.getElementById('dot' + i).className = 'rc-step-dot done';
    document.getElementById('lbl' + i).className = 'rc-step-label-txt';
    if (i < 3) document.getElementById('line' + i).className = 'rc-step-line done';
  }

  var loftSpec = specs[loftType];
  var roomSpec = loftSpec[roomUse];

  document.getElementById('resultSub').textContent =
    houseLabels[houseType] + ' · ' + loftSpec.name + ' · ' + roomLabels[roomUse];

  // Room Vision Card
  document.getElementById('rvIcon').textContent = roomIcons[roomUse];
  document.getElementById('rvLabel').textContent = loftSpec.name;
  document.getElementById('rvTitle').textContent = roomLabels[roomUse];
  document.getElementById('rvZones').innerHTML = zoneBlocks[roomUse];
  var feats = roomFeatures[loftType][roomUse];
  document.getElementById('rvFeatures').innerHTML = feats.map(function(f){
    return '<li style="display:flex;align-items:flex-start;gap:10px;font-size:13px;color:#374151;line-height:1.4;"><span style="color:#c9902e;font-weight:800;flex-shrink:0;">✓</span>' + f + '</li>';
  }).join('');

  // Info card
  document.getElementById('infoTitle').textContent = loftSpec.name;
  document.getElementById('infoPrice').textContent = 'From ' + roomSpec.price;
  document.getElementById('infoArea').textContent = roomSpec.area;
  document.getElementById('infoCeiling').textContent = roomSpec.ceiling;
  document.getElementById('infoBuild').textContent = roomSpec.build;
  document.getElementById('infoValue').textContent = roomSpec.value;
  document.getElementById('infoPlanning').innerHTML =
    '<span class="planning-badge ' + roomSpec.planning + '">' +
    (roomSpec.planning === 'green' ? '✓ Usually Permitted Development' : '⚠ Planning Permission Likely') +
    '</span>';
  document.getElementById('infoWhy').textContent = whyText[houseType][loftType];

  var result = document.getElementById('step-result');
  result.style.display = 'block';
  result.classList.add('active');
  result.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function restart() {
  houseType = null; loftType = null; roomUse = null;
  document.querySelectorAll('.choice-card, .loft-card, .room-card').forEach(function(c){ c.classList.remove('selected'); });
  ['next1','next2','next3'].forEach(function(id){ document.getElementById(id).classList.remove('ready'); });
  document.getElementById('step-result').style.display = 'none';
  document.getElementById('step-result').classList.remove('active');
  document.getElementById('recBanner').classList.remove('visible');
  goStep(1);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
