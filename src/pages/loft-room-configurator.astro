---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Loft Room Configurator | Plan Your Loft Conversion | Truleum"
  description="Answer 3 quick questions about your home and get a personalised loft conversion room plan — with pricing, dimensions, and build time. Free, instant, no registration."
  canonical="https://truleumloftspecialist.com/loft-room-configurator/"
>

<style>
*{box-sizing:border-box;margin:0;padding:0;}

/* ── Breadcrumb ── */
.rc-breadcrumb{background:#0d1f5c;border-bottom:1px solid rgba(255,255,255,0.08);padding:10px 20px;font-family:'Poppins',Arial,sans-serif;}
.rc-breadcrumb-inner{max-width:1000px;margin:0 auto;font-size:13px;color:rgba(255,255,255,0.5);display:flex;gap:8px;align-items:center;}
.rc-breadcrumb a{color:rgba(255,255,255,0.8);text-decoration:none;font-weight:600;}
.rc-breadcrumb a:hover{color:#c9902e;}

/* ── Hero ── */
.rc-hero{background:linear-gradient(135deg,#060f32 0%,#0f2460 100%);padding:52px 20px 44px;text-align:center;font-family:'Poppins',Arial,sans-serif;}
.rc-hero h1{font-size:clamp(1.7rem,3.5vw,2.5rem);font-weight:900;color:#fff;line-height:1.2;margin-bottom:10px;}
.rc-hero h1 em{font-style:normal;color:#c9902e;}
.rc-hero p{color:rgba(255,255,255,0.65);font-size:0.95rem;max-width:480px;margin:0 auto 28px;}

/* Step dots */
.rc-steps{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:4px;}
.rc-step-dot{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;font-family:'Poppins',Arial,sans-serif;transition:all 0.25s;}
.rc-step-dot.done{background:linear-gradient(135deg,#ffe89f 0%,#75561d 100%);color:#3d2600;}
.rc-step-dot.active{background:#fff;color:#0a1a4a;box-shadow:0 0 0 3px rgba(255,255,255,0.35);}
.rc-step-dot.pending{background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.4);}
.rc-step-line{width:48px;height:2px;background:rgba(255,255,255,0.2);}
.rc-step-line.done{background:linear-gradient(90deg,#ffe89f,#75561d);}
.rc-step-labels{display:flex;justify-content:center;gap:0;margin-top:6px;}
.rc-step-label-txt{width:32px;text-align:center;font-size:10px;font-family:'Poppins',Arial,sans-serif;color:rgba(255,255,255,0.45);line-height:1.3;}
.rc-step-label-txt.active{color:rgba(255,255,255,0.9);font-weight:600;}
.rc-step-spacer{width:48px;}

/* ── Body ── */
.rc-body{background:#f0f4f8;padding:52px 20px 240px;font-family:'Poppins',Arial,sans-serif;}
.rc-inner{max-width:900px;margin:0 auto;}

/* ── Steps ── */
.wiz-step{display:none;}
.wiz-step.active{display:block;}
.wiz-heading{font-size:1.15rem;font-weight:800;color:#0a1a4a;margin-bottom:6px;}
.wiz-sub{font-size:0.88rem;color:#6b7280;margin-bottom:28px;}

/* ── Choice cards (house) ── */
.choice-grid{display:grid;gap:14px;}
.choice-grid.cols2{grid-template-columns:repeat(2,1fr);}
.choice-card{background:#fff;border:2px solid #e5e7eb;border-radius:16px;padding:22px 18px 18px;cursor:pointer;transition:all 0.18s;text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px;position:relative;}
.choice-card:hover{border-color:#c9902e;transform:translateY(-2px);box-shadow:0 6px 24px rgba(10,26,74,0.1);}
.choice-card.selected{border-color:#0a1a4a;background:#f0f4fb;box-shadow:0 6px 24px rgba(10,26,74,0.12);}
.choice-icon{font-size:32px;line-height:1;}
.choice-name{font-size:13px;font-weight:700;color:#0a1a4a;line-height:1.3;}
.choice-desc{font-size:11.5px;color:#6b7280;line-height:1.4;}

/* Recommended badge */
.rec-badge{position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#ffe89f 0%,#75561d 100%);color:#3d2600;font-size:10px;font-weight:800;padding:3px 10px;border-radius:20px;white-space:nowrap;letter-spacing:0.04em;}

/* Recommendation banner */
.rec-banner{background:linear-gradient(135deg,#fff8e8 0%,#fdefc8 100%);border:1.5px solid #c9902e;border-radius:12px;padding:14px 18px;margin-bottom:24px;align-items:flex-start;gap:12px;display:none;}
.rec-banner.visible{display:flex;}
.rec-banner-icon{font-size:22px;flex-shrink:0;margin-top:1px;}
.rec-banner-text{font-size:13px;color:#5c3a00;line-height:1.5;}
.rec-banner-text strong{color:#3d2600;font-weight:700;}

/* ── Loft cards ── */
.loft-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;}
.loft-card{background:#fff;border:2px solid #e5e7eb;border-radius:14px;padding:18px 12px 14px;cursor:pointer;transition:all 0.18s;text-align:center;display:flex;flex-direction:column;align-items:center;gap:8px;position:relative;}
.loft-card:hover{border-color:#c9902e;transform:translateY(-2px);box-shadow:0 6px 24px rgba(10,26,74,0.1);}
.loft-card.selected{border-color:#0a1a4a;background:#f0f4fb;}
.loft-card.recommended{border-color:#c9902e;}
.loft-card-icon{font-size:28px;line-height:1;}
.loft-card-name{font-size:12px;font-weight:700;color:#0a1a4a;line-height:1.3;}
.loft-card-price{font-size:11px;color:#6b7280;}

/* ── Room cards ── */
.room-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.room-card{background:#fff;border:2px solid #e5e7eb;border-radius:16px;padding:26px 18px 20px;cursor:pointer;transition:all 0.18s;text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px;}
.room-card:hover{border-color:#c9902e;transform:translateY(-2px);box-shadow:0 6px 24px rgba(10,26,74,0.1);}
.room-card.selected{border-color:#0a1a4a;background:#f0f4fb;}
.room-card-icon{font-size:36px;line-height:1;}
.room-card-name{font-size:14px;font-weight:700;color:#0a1a4a;}
.room-card-desc{font-size:12px;color:#6b7280;line-height:1.4;}

/* ── Nav buttons ── */
.wiz-nav{display:flex;align-items:center;justify-content:space-between;margin-top:36px;}
.btn-back{background:none;border:2px solid #d1d5db;color:#6b7280;font-size:14px;font-weight:600;font-family:'Poppins',Arial,sans-serif;padding:11px 24px;border-radius:10px;cursor:pointer;transition:all 0.15s;}
.btn-back:hover{border-color:#0a1a4a;color:#0a1a4a;}
.btn-next{background:linear-gradient(135deg,#ffe89f 0%,#75561d 100%);border:none;color:#3d2600;font-size:14px;font-weight:700;font-family:'Poppins',Arial,sans-serif;padding:13px 32px;border-radius:10px;cursor:pointer;box-shadow:0 4px 20px rgba(117,86,29,0.35);transition:all 0.15s;opacity:0.5;pointer-events:none;}
.btn-next.ready{opacity:1;pointer-events:auto;}
.btn-next.ready:hover{transform:translateY(-1px);box-shadow:0 6px 24px rgba(117,86,29,0.45);}

/* ── Result ── */
#step-result{display:none;}
#step-result.active{display:block;}

.result-heading{font-size:1.1rem;font-weight:800;color:#0a1a4a;margin-bottom:4px;}
.result-sub{font-size:0.85rem;color:#6b7280;margin-bottom:22px;}
.result-grid{display:grid;grid-template-columns:1fr 300px;gap:28px;align-items:start;}

/* ── Room Vision Card ── */
.rv-card{background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 6px 30px rgba(10,26,74,0.1);}
.rv-header{background:linear-gradient(135deg,#060f32 0%,#0f2460 100%);padding:20px 24px;display:flex;align-items:center;gap:14px;}
.rv-header-icon{width:48px;height:48px;background:linear-gradient(135deg,#ffe89f 0%,#75561d 100%);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.rv-header-text{}
.rv-header-label{font-size:10px;font-weight:700;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:2px;}
.rv-header-title{font-size:15px;font-weight:800;color:#fff;line-height:1.2;}

/* Zone visual */
.rv-zones{display:flex;gap:6px;padding:20px 24px 0;height:72px;}
.rv-zone{border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex:1;text-align:center;line-height:1.3;}
.rv-zone.z-bedroom{background:linear-gradient(135deg,#1e3a8a,#1d4ed8);}
.rv-zone.z-ensuite{background:linear-gradient(135deg,#0e7490,#06b6d4);}
.rv-zone.z-office{background:linear-gradient(135deg,#92400e,#d97706);}
.rv-zone.z-landing{background:#e5e7eb;color:#9ca3af;font-size:10px;flex:0 0 56px;}

/* Features list */
.rv-features{padding:20px 24px 24px;}
.rv-features-label{font-size:10px;font-weight:800;color:#9ca3af;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:14px;}
.rv-feature-list{list-style:none;display:flex;flex-direction:column;gap:10px;}
.rv-feature-list li{display:flex;align-items:flex-start;gap:10px;font-size:13px;color:#374151;line-height:1.4;}
.rv-feature-list li::before{content:'✓';color:#c9902e;font-weight:800;font-size:13px;flex-shrink:0;margin-top:1px;}

/* ── Info card ── */
.info-card{background:#fff;border-radius:18px;padding:26px 22px;box-shadow:0 6px 30px rgba(10,26,74,0.1);display:flex;flex-direction:column;gap:14px;}
.info-card-title{font-size:13px;font-weight:800;color:#0a1a4a;text-transform:uppercase;letter-spacing:0.08em;padding-bottom:12px;border-bottom:2px solid #f0f4f8;}
.info-row{display:flex;justify-content:space-between;align-items:baseline;gap:8px;}
.info-label{font-size:12px;color:#6b7280;font-weight:500;}
.info-value{font-size:13px;font-weight:700;color:#0a1a4a;text-align:right;}
.info-value.gold{color:#c9902e;}
.info-divider{border:none;border-top:1px solid #f0f4f8;}
.planning-badge{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px;}
.planning-badge.green{background:#dcfce7;color:#15803d;}
.planning-badge.amber{background:#fef9c3;color:#a16207;}
.why-box{background:#f8f9fb;border-radius:10px;padding:14px 16px;font-size:12.5px;color:#374151;line-height:1.55;border-left:3px solid #c9902e;}

/* CTA */
.result-cta{margin-top:4px;}
.result-cta a{display:block;background:linear-gradient(135deg,#ffe89f 0%,#75561d 100%);color:#3d2600;text-decoration:none;font-size:15px;font-weight:800;font-family:'Poppins',Arial,sans-serif;text-align:center;padding:16px 24px;border-radius:12px;box-shadow:0 4px 20px rgba(117,86,29,0.35);transition:all 0.15s;}
.result-cta a:hover{transform:translateY(-2px);box-shadow:0 6px 28px rgba(117,86,29,0.45);}
.result-cta p{font-size:11.5px;color:#9ca3af;text-align:center;margin-top:10px;}
.btn-restart{background:none;border:none;color:#c9902e;font-size:13px;font-weight:600;font-family:'Poppins',Arial,sans-serif;cursor:pointer;text-decoration:underline;display:block;margin:18px auto 0;text-align:center;}
.btn-restart:hover{color:#a07020;}

/* ── Responsive ── */
@media(max-width:760px){
  .loft-grid{grid-template-columns:repeat(3,1fr);}
  .room-grid{grid-template-columns:repeat(2,1fr) !important;}
  .result-grid{grid-template-columns:1fr;}
  .choice-grid.cols2{grid-template-columns:1fr 1fr;}
}
@media(max-width:500px){
  .loft-grid{grid-template-columns:repeat(2,1fr);}
  .room-grid{grid-template-columns:1fr !important;}
}
</style>

<!-- Breadcrumb -->
<nav class="rc-breadcrumb" aria-label="Breadcrumb">
  <div class="rc-breadcrumb-inner">
    <a href="/">Home</a><span>›</span><span>Loft Room Configurator</span>
  </div>
</nav>

<!-- Hero -->
<div class="rc-hero">
  <h1>Design Your <em>Loft Conversion</em></h1>
  <p>3 quick questions → get your personalised room plan with pricing, dimensions and build time.</p>
  <div class="rc-steps" id="stepDots">
    <div class="rc-step-dot active" id="dot1">1</div>
    <div class="rc-step-line" id="line1"></div>
    <div class="rc-step-dot pending" id="dot2">2</div>
    <div class="rc-step-line" id="line2"></div>
    <div class="rc-step-dot pending" id="dot3">3</div>
  </div>
  <div class="rc-step-labels">
    <div class="rc-step-label-txt active" id="lbl1">House</div>
    <div class="rc-step-spacer"></div>
    <div class="rc-step-label-txt" id="lbl2">Loft</div>
    <div class="rc-step-spacer"></div>
    <div class="rc-step-label-txt" id="lbl3">Room</div>
  </div>
</div>

<!-- Body -->
<div class="rc-body">
  <div class="rc-inner">

    <!-- STEP 1: House Type -->
    <div class="wiz-step active" id="step1">
      <div class="wiz-heading">What type of house do you have?</div>
      <div class="wiz-sub">This helps us recommend the best loft conversion for your property.</div>
      <div class="choice-grid cols2">
        <div class="choice-card" data-val="terraced" onclick="pickHouse(this)">
          <span class="choice-icon">🏘️</span>
          <span class="choice-name">Terraced House</span>
          <span class="choice-desc">Shared walls on both sides</span>
        </div>
        <div class="choice-card" data-val="semi" onclick="pickHouse(this)">
          <span class="choice-icon">🏠</span>
          <span class="choice-name">Semi-Detached</span>
          <span class="choice-desc">Shared wall on one side</span>
        </div>
        <div class="choice-card" data-val="detached" onclick="pickHouse(this)">
          <span class="choice-icon">🏡</span>
          <span class="choice-name">Detached House</span>
          <span class="choice-desc">No shared walls, more freedom</span>
        </div>
        <div class="choice-card" data-val="bungalow" onclick="pickHouse(this)">
          <span class="choice-icon">🛖</span>
          <span class="choice-name">Bungalow</span>
          <span class="choice-desc">Single-storey, ideal for full loft</span>
        </div>
      </div>
      <div class="wiz-nav" style="justify-content:flex-end;">
        <button class="btn-next" id="next1" onclick="goStep(2)">Next: Choose Loft Type →</button>
      </div>
    </div>

    <!-- STEP 2: Loft Type -->
    <div class="wiz-step" id="step2">
      <div class="wiz-heading">What type of loft conversion do you want?</div>
      <div class="wiz-sub">We've highlighted the best option for your house type — but you can choose any.</div>
      <div class="rec-banner" id="recBanner">
        <span class="rec-banner-icon">💡</span>
        <span class="rec-banner-text" id="recBannerText"></span>
      </div>
      <div class="loft-grid">
        <div class="loft-card" data-val="velux" onclick="pickLoft(this)">
          <span class="rec-badge" style="display:none;" id="badge-velux">⭐ Recommended</span>
          <span class="loft-card-icon">🪟</span>
          <span class="loft-card-name">Velux / Rooflight</span>
          <span class="loft-card-price">From £18,000</span>
        </div>
        <div class="loft-card" data-val="dormer" onclick="pickLoft(this)">
          <span class="rec-badge" style="display:none;" id="badge-dormer">⭐ Recommended</span>
          <span class="loft-card-icon">🏠</span>
          <span class="loft-card-name">Dormer</span>
          <span class="loft-card-price">From £28,000</span>
        </div>
        <div class="loft-card" data-val="hipgable" onclick="pickLoft(this)">
          <span class="rec-badge" style="display:none;" id="badge-hipgable">⭐ Recommended</span>
          <span class="loft-card-icon">🔺</span>
          <span class="loft-card-name">Hip-to-Gable</span>
          <span class="loft-card-price">From £34,000</span>
        </div>
        <div class="loft-card" data-val="lshaped" onclick="pickLoft(this)">
          <span class="rec-badge" style="display:none;" id="badge-lshaped">⭐ Recommended</span>
          <span class="loft-card-icon">📐</span>
          <span class="loft-card-name">L-Shaped Dormer</span>
          <span class="loft-card-price">From £38,000</span>
        </div>
        <div class="loft-card" data-val="mansard" onclick="pickLoft(this)">
          <span class="rec-badge" style="display:none;" id="badge-mansard">⭐ Recommended</span>
          <span class="loft-card-icon">🏛️</span>
          <span class="loft-card-name">Mansard</span>
          <span class="loft-card-price">From £42,000</span>
        </div>
      </div>
      <div class="wiz-nav">
        <button class="btn-back" onclick="goStep(1)">← Back</button>
        <button class="btn-next" id="next2" onclick="goStep(3)">Next: Choose Room Use →</button>
      </div>
    </div>

    <!-- STEP 3: Room Use -->
    <div class="wiz-step" id="step3">
      <div class="wiz-heading">How will you use the loft space?</div>
      <div class="wiz-sub">Your room use shapes the layout, storage options, and finish.</div>
      <div class="room-grid">
        <div class="room-card" data-val="bedroom" onclick="pickRoom(this)">
          <span class="room-card-icon">🛏️</span>
          <span class="room-card-name">Extra Bedroom</span>
          <span class="room-card-desc">Double bed, wardrobe, access to shared bathroom</span>
        </div>
        <div class="room-card" data-val="ensuite" onclick="pickRoom(this)">
          <span class="room-card-icon">🚿</span>
          <span class="room-card-name">Bedroom + En-suite</span>
          <span class="room-card-desc">Double bed, private shower room or wet room</span>
        </div>
        <div class="room-card" data-val="office" onclick="pickRoom(this)">
          <span class="room-card-icon">💻</span>
          <span class="room-card-name">Home Office</span>
          <span class="room-card-desc">Desk space, storage, maximum natural light</span>
        </div>
      </div>
      <div class="wiz-nav">
        <button class="btn-back" onclick="goStep(2)">← Back</button>
        <button class="btn-next" id="next3" onclick="showResult()">See My Room Plan →</button>
      </div>
    </div>

    <!-- RESULT -->
    <div id="step-result">
      <div class="result-heading">Your Personalised Loft Room</div>
      <div class="result-sub" id="resultSub"></div>

      <div class="result-grid">

        <!-- Room Vision Card -->
        <div class="rv-card">
          <div class="rv-header">
            <div class="rv-header-icon" id="rvIcon"></div>
            <div class="rv-header-text">
              <div class="rv-header-label" id="rvLabel"></div>
              <div class="rv-header-title" id="rvTitle"></div>
            </div>
          </div>
          <div class="rv-zones" id="rvZones"></div>
          <div class="rv-features">
            <div class="rv-features-label">What's included in your loft</div>
            <ul class="rv-feature-list" id="rvFeatures"></ul>
          </div>
        </div>

        <!-- Info card -->
        <div>
          <div class="info-card">
            <div class="info-card-title" id="infoTitle"></div>
            <div class="info-row">
              <span class="info-label">Starting Price</span>
              <span class="info-value gold" id="infoPrice"></span>
            </div>
            <hr class="info-divider">
            <div class="info-row">
              <span class="info-label">Usable Floor Area</span>
              <span class="info-value" id="infoArea"></span>
            </div>
            <div class="info-row">
              <span class="info-label">Max Ceiling Height</span>
              <span class="info-value" id="infoCeiling"></span>
            </div>
            <div class="info-row">
              <span class="info-label">Typical Build Time</span>
              <span class="info-value" id="infoBuild"></span>
            </div>
            <div class="info-row">
              <span class="info-label">Added Property Value</span>
              <span class="info-value gold" id="infoValue"></span>
            </div>
            <hr class="info-divider">
            <div class="info-row">
              <span class="info-label">Planning Permission</span>
              <span class="info-value" id="infoPlanning"></span>
            </div>
            <hr class="info-divider">
            <div class="why-box" id="infoWhy"></div>
            <div class="result-cta">
              <a href="/contact/">Get a Free Quote for This Room</a>
              <p>No obligation — free site visit in Cambridge &amp; Cambridgeshire</p>
            </div>
          </div>
          <button class="btn-restart" onclick="restart()">← Start Over</button>
        </div>
      </div>
    </div>

  </div>
</div>

<script is:inline>
var houseType = null, loftType = null, roomUse = null;

var recMap = {
  terraced: { loft: 'dormer',   reason: 'Terraced houses suit a <strong>rear Dormer</strong> — maximum headroom without touching the party walls.' },
  semi:     { loft: 'hipgable', reason: 'Semi-detached properties are ideal for a <strong>Hip-to-Gable</strong> — uses the sloping end wall for maximum space.' },
  detached: { loft: 'mansard',  reason: 'Detached homes have the freedom for a full <strong>Mansard</strong> — the most spacious and value-adding option.' },
  bungalow: { loft: 'dormer',   reason: 'Bungalows benefit most from a <strong>Dormer</strong> — transforms the roof into a full usable storey.' }
};

var specs = {
  velux: {
    name: 'Velux / Rooflight Conversion',
    bedroom:  { price:'£18,000', area:'20–25 m²', ceiling:'2.2 m', build:'4–6 weeks', value:'+10–15%', planning:'green' },
    ensuite:  { price:'£22,000', area:'20–25 m²', ceiling:'2.2 m', build:'5–7 weeks', value:'+12–16%', planning:'green' },
    office:   { price:'£18,000', area:'20–28 m²', ceiling:'2.2 m', build:'4–6 weeks', value:'+8–12%',  planning:'green' }
  },
  dormer: {
    name: 'Dormer Loft Conversion',
    bedroom:  { price:'£28,000', area:'25–35 m²', ceiling:'2.4 m', build:'6–8 weeks', value:'+15–20%', planning:'green' },
