---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Truleum | Cambridge Loft Conversion Specialists"
  description="Meet Truleum's expert team of Cambridge loft conversion specialists. Trusted local builders with years of experience transforming lofts across Cambridge and surrounding areas."
  ogImage="/wp-content/uploads/Kitchen-Refurbishment/best-service-kitchen-cambridge.webp"
>
  <link slot="head" rel="stylesheet" href="/wp-content/themes/truleum-theme/assets/css/about.css">
  <link slot="head" rel="stylesheet" href="/wp-content/themes/truleum-theme/assets/css/contact.css">

<main class="main-content about-page">

<div class="about-truleum">
    <div class="about-container">
        <div class="about-image-column">
            <img src="/wp-content/uploads/2025/09/renovation-service.webp" alt="Luxury Home Renovation by Truleum" class="about-image">
        </div>
        <div class="about-content-column">
            <span class="about-tag">About Truleum</span>
            <h1 class="about-title">Expert Home Transformations in Cambridge &amp; London</h1>
            <p class="about-description">At Truleum, we specialize in turning houses into dream homes through expert loft conversions, home extensions, and complete property renovations. Serving Cambridge, Cambridgeshire, and London, we combine innovative design with exceptional craftsmanship to create spaces that perfectly match your vision and lifestyle.</p>
            <p class="about-description">Our dedicated team manages every aspect of your project, from initial consultation to final completion, ensuring a seamless and stress-free experience. We take pride in our attention to detail and commitment to delivering outstanding results that exceed expectations.</p>
            <p class="about-description" style="font-size:15px;">Useful links: <a href="/services/loft-conversion-cambridge-service/">Loft Conversion Cambridge Service</a> | <a href="/loft-conversion-cambridge/">Cambridge Area Page</a> | <a href="/loft-conversion-glossary/">Loft Conversion Glossary</a> | <a href="https://www.gov.uk/building-regulations-approval" target="_blank" rel="noopener nofollow">Building Regulations</a></p>
            <div class="about-buttons">
                <a href="/gallery/" class="about-btn-primary">VIEW OUR WORK</a>
                <a href="/contact/" class="about-btn-secondary">CONTACT US</a>
            </div>
        </div>
    </div>
</div>

<div class="why-choose-us">
    <div class="why-choose-container">
        <h2 class="why-choose-title">Why Choose Truleum?</h2>
        <div class="reasons-grid">
            <div class="reason-card">
                <div class="reason-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h3>Personalized Service</h3>
                <p>One-to-one project management from initial consultation to final inspection, ensuring your vision becomes reality.</p>
            </div>
            <div class="reason-card">
                <div class="reason-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 14.66V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h5.34"></path>
                        <polygon points="18 2 22 6 12 16 8 16 8 12 18 2"></polygon>
                    </svg>
                </div>
                <h3>Quality Craftsmanship</h3>
                <p>Our skilled tradespeople deliver exceptional workmanship using premium materials and proven techniques.</p>
            </div>
            <div class="reason-card">
                <div class="reason-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                </div>
                <h3>Transparent Process</h3>
                <p>Clear communication and detailed quotes with no hidden costs, keeping you informed at every stage of your project.</p>
            </div>
        </div>
    </div>
</div>

<div class="where-we-are-based">
    <div class="where-container">
        <h2 class="where-title">WHERE WE ARE BASED</h2>
        <div class="locations-grid">
            <div class="location-card">
                <div class="location-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="auto" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </div>
                <h3 class="location-name">Cambridge</h3>
                <p class="location-description">Serving Cambridge and surrounding areas with premium home transformation services.</p>
            </div>
            <div class="location-card">
                <div class="location-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="auto" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </div>
                <h3 class="location-name">Cambridgeshire</h3>
                <p class="location-description">Covering all of Cambridgeshire with our expert home improvement solutions.</p>
            </div>
            <div class="location-card">
                <div class="location-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="auto" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </div>
                <h3 class="location-name">London</h3>
                <p class="location-description">Transforming homes across London with our professional renovation services.</p>
            </div>
        </div>
    </div>
</div>

<section class="dont-delay-section section">
    <div class="contact-cta">
        <div>
            <h2>DON'T DELAY CONTACT US TODAY</h2>
            <p>Contact us today for more information and a free no-obligation quote tailored to your requirements and ideas.</p>
            <a href="/contact/" class="dont-delay">ENQUIRE NOW</a>
        </div>
    </div>
</section>

</main>

<script is:inline src="/wp-content/themes/truleum-theme/assets/js/about.js"></script>
</BaseLayout>
