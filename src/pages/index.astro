                />
                <span class="ba-label ba-label-after">After</span>
            </div>
            <div class="ba-handle" id="baHandle">
                <div class="ba-handle-line"></div>
                <div class="ba-handle-circle">
                    <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                        <path d="M7 11L3 7M7 11L3 15M7 11H19M15 7L19 11M15 15L19 11" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="ba-handle-line"></div>
            </div>
            <div class="ba-drag-hint">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M4 7H10M4 7L2 5M4 7L2 9M10 7L12 5M10 7L12 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                Drag to compare
