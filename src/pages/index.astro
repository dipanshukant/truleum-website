    s.textContent = '.rt-read-more{display:inline-flex;align-items:center;gap:6px;margin-top:10px;background:transparent;border:1.5px solid #f59e0b;color:#f59e0b;font-size:12.5px;font-weight:600;font-family:Poppins,Arial,sans-serif;cursor:pointer;padding:6px 16px;border-radius:6px;letter-spacing:.02em;transition:background .2s,color .2s}.rt-read-more:hover{background:#f59e0b;color:#fff}';
    document.head.appendChild(s);
    document.querySelectorAll('.review-text').forEach(function(p){
        if(p.scrollHeight > p.clientHeight + 4){
            var btn = document.createElement('button');
            btn.className = 'rt-read-more';
            btn.textContent = 'Read full review ▾';
            btn.setAttribute('aria-expanded','false');
            btn.addEventListener('click', function(){
                var expanded = p.classList.toggle('rt-expanded');
                btn.textContent = expanded ? 'Show less ▴' : 'Read full review ▾';
                btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            });
            p.parentNode.insertBefore(btn, p.nextSibling);
        }
    });
})();
</script>

