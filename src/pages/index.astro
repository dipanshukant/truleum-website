---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Loft Conversion Cambridge | Truleum Specialists"
  description="Expert loft conversion services in Cambridge. Skilled specialists delivering quality work and reliable attic transformations for your home needs."
  ogImage="/wp-content/uploads/House-Extension/house-extension-london-area.webp"
>
  <link slot="head" rel="preload" as="image" href="/wp-content/uploads/2025/09/cambridgeshire-house-extension-beam-installation.webp" fetchpriority="high">
  <link slot="head" rel="stylesheet" href="/wp-content/themes/truleum-theme/assets/css/hero-slideshow.css">

<!-- Hero Section -->
<section class="hero-section section">
    <div class="hero-slideshow">
        <div class="hero-slide active" data-bg="/wp-content/uploads/2025/09/cambridgeshire-house-extension-beam-installation.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/Kitchen-Refurbishment/renovation-service-kitchen.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/Bathroom-Renovation/london-renovation-bathroom.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/Bathroom-Renovation/cambridgeshire-loft-conversion-scaffolding-1.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/House-Extension/house-extension-london.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/House-Extension/construction-company-cambridge.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/2025/09/cambridge-loft-conversion-plumbing-installation.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/2025/09/cambridgeshire-house-extension-foundation-work.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/2025/09/cambridge-loft-conversion-construction-work.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/2025/09/cambridge-loft-conversion-construction-renovation.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/2025/09/cambridge-loft-conversion-completion-project.webp"></div>
        <div class="hero-slide" data-bg="/wp-content/uploads/2025/09/cambridge-kitchen-renovation-modern.webp"></div>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-text">
        <h1>Expert Loft Conversion Cambridge<br><span> Specialists</span></h1>
        <p>Professional loft conversions, house extensions, bathroom renovation &amp; kitchen refurbishment company</p>
        <a href="/contact/" class="cta-btn">FREE NO OBLIGATION QUOTE</a>
        <p style="margin-top:16px; font-size:14px; line-height:1.7; color:rgba(255,255,255,0.92);">Resources: <a href="/services/loft-conversion-cambridge-service/" style="color:#ffe89f; font-weight:600;">Service Page</a> | <a href="/loft-conversion-cambridge/" style="color:#ffe89f; font-weight:600;">Cambridge Area Page</a> | <a href="/loft-conversion-glossary/" style="color:#ffe89f; font-weight:600;">Loft Conversion Glossary</a> | <a href="https://www.planningportal.co.uk/permission/common-projects/loft-conversion" target="_blank" rel="noopener nofollow" style="color:#ffe89f; font-weight:600;">Planning Rules</a></p>
    </div>
</section>

<div style="background:#ffffff; height:110px;"></div>

<!-- Who We Are Section -->
<section class="wwa-section">
<style>
.wwa-section {
    background: #0a1a4a;
    font-family: 'Poppins', Arial, sans-serif;
}
.wwa-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 540px;
}
.wwa-img-col {
    position: relative;
    overflow: hidden;
}
.wwa-img-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
}
.wwa-img-col:hover img { transform: scale(1.03); }
.wwa-content {
    padding: 64px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0;
}
.wwa-tag {
    display: inline-block;
    background: rgba(245,158,11,0.15);
    color: #f59e0b;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 5px 16px;
    border-radius: 50px;
    border: 1px solid rgba(245,158,11,0.3);
    margin-bottom: 20px;
    width: fit-content;
}
.wwa-content h2 {
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
    margin: 0 0 18px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.wwa-content p {
    font-size: 0.97rem;
    line-height: 1.75;
    color: rgba(255,255,255,0.82);
    margin: 0 0 24px;
}
.wwa-list {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.wwa-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.95rem;
    color: rgba(255,255,255,0.9);
}
.wwa-list li .wwa-check {
    width: 22px;
    height: 22px;
    background: rgba(245,158,11,0.15);
    border: 1.5px solid rgba(245,158,11,0.4);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #f59e0b;
    font-size: 12px;
    font-weight: 700;
}
.wwa-btns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
}
.wwa-btn-primary {
    background: #f59e0b;
    color: #0a1a4a;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 13px 26px;
    border-radius: 50px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
}
.wwa-btn-primary:hover { background: #fbbf24; transform: translateY(-1px); }
.wwa-btn-secondary {
    background: transparent;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 13px 26px;
    border-radius: 50px;
    border: 2px solid rgba(255,255,255,0.35);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
}
.wwa-btn-secondary:hover { border-color: #fff; color: #fff; transform: translateY(-1px); }
@media (max-width: 860px) {
    .wwa-inner { grid-template-columns: 1fr; }
    .wwa-img-col { min-height: 320px; }
    .wwa-content { padding: 48px 28px; }
}
</style>

<div class="wwa-inner">
    <div class="wwa-img-col">
        <img src="/wp-content/uploads/2025/09/cambridge-loft-conversion-specialists.png" alt="Cambridge Loft Conversion Specialists by Truleum">
    </div>
    <div class="wwa-content">
        <span class="wwa-tag">Who We Are</span>
        <h2>Leading Loft Conversion Cambridge &amp; House Extension Specialists</h2>
        <p>Expert loft conversion Cambridge specialists serving Cambridge and Cambridgeshire areas. Our professional team delivers exceptional house extensions, bathroom renovation, and kitchen refurbishment services with outstanding craftsmanship.</p>
        <ul class="wwa-list">
            <li><span class="wwa-check">✓</span> Loft conversions Cambridge &amp; Cambridgeshire</li>
            <li><span class="wwa-check">✓</span> House extensions and home extensions</li>
            <li><span class="wwa-check">✓</span> Bathroom renovation and refurbishment</li>
            <li><span class="wwa-check">✓</span> Kitchen refurbishment and installation</li>
        </ul>
        <div class="wwa-btns">
            <a href="/gallery/" class="wwa-btn-primary">View Our Work</a>
            <a href="/contact/" class="wwa-btn-secondary">Get a Free Quote</a>
        </div>
    </div>
</div>
</section>

<!-- Why Truleum Section -->
<section class="why-truleum-section section">
    <div class="truleum-container">
        <div class="wtc-eyebrow">Why Choose Us</div>
        <h2>WHY CHOOSE TRULEUM FOR LOFT CONVERSION CAMBRIDGE<span></span></h2>
        <p class="wtc-subtitle">Cambridge homeowners trust us for quality builds, clear communication and fair pricing.</p>
        <div class="features-container">
            <div class="feature-card">
                <div class="feature-num">01</div>
                <h3 class="feature-title">5★ Google Rated</h3>
                <p class="feature-text">Every review is 5 stars. Our work speaks for itself.</p>
            </div>
            <div class="feature-card">
                <div class="feature-num">02</div>
                <h3 class="feature-title">Personal Service</h3>
                <p class="feature-text">One dedicated manager from survey to final finish.</p>
            </div>
            <div class="feature-card">
                <div class="feature-num">03</div>
                <h3 class="feature-title">Free Quote</h3>
                <p class="feature-text">No obligation. We visit, assess and quote at zero cost.</p>
            </div>
            <div class="feature-card">
                <div class="feature-num">04</div>
                <h3 class="feature-title">Price Promise</h3>
                <p class="feature-text">Show us any like-for-like quote and we will beat it.</p>
            </div>
        </div>
        <div class="cta-buttons">
            <a href="/contact/" class="why-tru">FREE QUOTE</a>
            <a href="/about-us/" class="why-tru">FIND OUT MORE</a>
        </div>
    </div>
</section>

<!-- Section Spacer -->
<div style="background:#ffffff; height:110px;"></div>

<!-- Where We Operate Section -->
<!-- Interactive Coverage Map Section -->
<section class="coverage-map-section">
  <style>
  .coverage-map-section {
    background: #0a1a4a;
    padding: 72px 24px 230px;
    font-family: 'Poppins', Arial, sans-serif;
  }
  .map-layout {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  /* LEFT: map */
  .map-col { position: relative; }
  .cambs-map {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .county-fill {
    fill: rgba(13, 31, 82, 0.6);
    stroke: rgba(100, 150, 255, 0.22);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .connector-line {
    stroke: rgba(245,158,11,0.13);
    stroke-width: 1;
    stroke-dasharray: 4 5;
    fill: none;
  }
  .area-pin { cursor: pointer; text-decoration: none; }
  .pin-pulse {
    fill: none;
    stroke: rgba(245,158,11,0.45);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    animation: mapPulse 2.4s ease-out infinite;
  }
  @keyframes mapPulse {
    0%   { transform: scale(1);   opacity: 0.7; }
    100% { transform: scale(2.8); opacity: 0;   }
  }
  .pin-dot {
    fill: #f59e0b;
    filter: drop-shadow(0 0 5px rgba(245,158,11,0.55));
    transition: fill 0.2s;
  }
  .pin-hub {
    fill: #fbbf24;
    filter: drop-shadow(0 0 9px rgba(251,191,36,0.75));
    transition: fill 0.2s;
  }
  .area-pin:hover .pin-dot { fill: #fde68a; filter: drop-shadow(0 0 12px rgba(251,191,36,0.9)); }
  .area-pin:hover .pin-hub { fill: #fff5c0; filter: drop-shadow(0 0 16px rgba(255,245,192,1)); }
  .pin-label {
    fill: #cbd5e1;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Poppins', Arial, sans-serif;
    text-anchor: middle;
    pointer-events: none;
    transition: fill 0.2s;
  }
  .pin-label-hub {
    fill: #fbbf24;
    font-size: 15px;
    font-weight: 700;
    font-family: 'Poppins', Arial, sans-serif;
    text-anchor: middle;
    pointer-events: none;
  }
  .area-pin:hover .pin-label     { fill: #f59e0b; }
  .area-pin:hover .pin-label-hub { fill: #fff; }
  .pin-tooltip { display: none; }
  .tooltip-bg { fill: #0a1a4a; stroke: rgba(245,158,11,0.4); stroke-width: 1; }
  .tooltip-txt {
    fill: #f59e0b;
    font-size: 9px;
    font-weight: 700;
    font-family: 'Poppins', Arial, sans-serif;
    text-anchor: middle;
  }
  /* RIGHT: info panel */
  .map-info-col { display: flex; flex-direction: column; gap: 0; }
  .map-eyebrow {
    display: inline-block;
    background: rgba(245,158,11,0.12);
    color: #f59e0b;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 5px 16px;
    border-radius: 50px;
    border: 1px solid rgba(245,158,11,0.28);
    margin-bottom: 16px;
    width: fit-content;
  }
  .map-info-col h2 {
    color: #fff;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 800;
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .map-info-col h2 span { color: #f59e0b; }
  .map-info-col > p {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 0 0 28px;
    line-height: 1.6;
  }
  .area-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 10px;
    margin-bottom: 28px;
  }
  .area-chip {
    display: flex;
    align-items: center;
    gap: 7px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(245,158,11,0.2);
    color: #cbd5e1;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
    font-family: 'Poppins', Arial, sans-serif;
    white-space: nowrap;
  }
  .area-chip:hover {
    background: rgba(245,158,11,0.13);
    border-color: #f59e0b;
    color: #f59e0b;
    transform: translateY(-1px);
  }
  .area-chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f59e0b;
    flex-shrink: 0;
  }
  .map-cta-note {
    color: #64748b;
    font-size: 0.82rem;
    font-family: 'Poppins', Arial, sans-serif;
    margin: 0;
  }
  .map-cta-note a { color: #f59e0b; text-decoration: none; font-weight: 600; }
  .map-cta-note a:hover { text-decoration: underline; }
  @media (max-width: 860px) {
    .map-layout { grid-template-columns: 1fr; gap: 36px; }
    .area-grid  { grid-template-columns: 1fr 1fr; }
    .map-col    { max-width: 480px; margin: 0 auto; width: 100%; }
  }
  @media (max-width: 480px) {
    .area-grid { grid-template-columns: 1fr 1fr; }
    .area-chip { font-size: 0.75rem; padding: 8px 10px; }
  }
  </style>

