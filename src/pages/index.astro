    <script is:inline>
    (function() {
        var prices = {
            velux:    { small: [18000,24000], medium: [22000,28000], large: [26000,34000] },
            dormer:   { small: [28000,38000], medium: [34000,46000], large: [42000,58000] },
            hipgable: { small: [34000,46000], medium: [40000,54000], large: [50000,68000] },
            mansard:  { small: [42000,58000], medium: [52000,70000], large: [65000,85000] },
            lshaped:  { small: [38000,52000], medium: [46000,62000], large: [58000,78000] }
        };
        var finishMult = { standard: 1, premium: 1.15, luxury: 1.35 };
        var sel = { type: 'velux', size: 'small', finish: 'standard' };

        function fmt(n) { return '£' + n.toLocaleString('en-GB'); }

        function update() {
            var priceEl = document.getElementById('qcPrice');
            if (!priceEl) return;
            priceEl.classList.add('updating');
            setTimeout(function() {
                var base = prices[sel.type][sel.size];
                var mult = finishMult[sel.finish];
                var lo = Math.round(base[0] * mult / 500) * 500;
                var hi = Math.round(base[1] * mult / 500) * 500;
                priceEl.textContent = fmt(lo) + ' – ' + fmt(hi);
                priceEl.classList.remove('updating');
            }, 120);
        }

        document.querySelectorAll('.qc-opt').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var key = btn.dataset.key;
                document.querySelectorAll('.qc-opt[data-key="' + key + '"]').forEach(function(b) {
                    b.classList.remove('qc-opt--active');
                });
                btn.classList.add('qc-opt--active');
                sel[key] = btn.dataset.val;
                update();
            });
        });
    })();
    </script>
