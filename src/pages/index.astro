    <script is:inline>
    (function() {
        var slider = document.getElementById('baSlider');
        if (!slider) return;
        var afterEl = slider.querySelector('.ba-after');
        var handleEl = slider.querySelector('.ba-handle');
        var hint = slider.querySelector('.ba-drag-hint');
        var dragging = false;

        function setPosition(x) {
            var rect = slider.getBoundingClientRect();
            var pct = Math.max(2, Math.min(98, ((x - rect.left) / rect.width) * 100));
            afterEl.style.clipPath = 'inset(0 ' + (100 - pct) + '% 0 0)';
            handleEl.style.left = pct + '%';
        }

        function startDrag(x) {
            dragging = true;
            if (hint) hint.style.display = 'none';
            setPosition(x);
        }

        slider.addEventListener('mousedown', function(e) { startDrag(e.clientX); e.preventDefault(); });
        window.addEventListener('mousemove', function(e) { if (dragging) setPosition(e.clientX); });
        window.addEventListener('mouseup', function() { dragging = false; });
        slider.addEventListener('touchstart', function(e) { startDrag(e.touches[0].clientX); }, { passive: true });
        window.addEventListener('touchmove', function(e) { if (dragging) setPosition(e.touches[0].clientX); }, { passive: true });
        window.addEventListener('touchend', function() { dragging = false; });

        /* Animate in from left on load for visual hook */
        var pct = 25;
        var target = 50;
        var raf;
        function sweep() {
            pct += (target - pct) * 0.06;
            afterEl.style.clipPath = 'inset(0 ' + (100 - pct) + '% 0 0)';
            handleEl.style.left = pct + '%';
            if (Math.abs(pct - target) > 0.2) raf = requestAnimationFrame(sweep);
        }
        setTimeout(function() { if (!dragging) raf = requestAnimationFrame(sweep); }, 600);
    })();
    </script>
</section>

